# Secret PIN Code for App Access (Default: 1234)
# Customize this with your own private PIN code (e.g., 2003, 4321, etc.)
NEXT_PUBLIC_APP_PIN=1234

# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Cloud Places API Configuration
# Found in: Google Cloud Console -> APIs & Services -> Credentials
# Enable: "Places API (New)" or "Places API"
GOOGLE_PLACES_API_KEY=AIzaSy...

# Single Owner Personal Account (Exclusive owner email)
# When specified, only this email address can access the app; public sign-ups are blocked.
NEXT_PUBLIC_OWNER_EMAIL=

# Google Gemini AI API Key (for Varex AI Assistant)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Resend Email Delivery API Key (for Varex AI Direct Email Outreach)
# Create or get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Optional Custom Sender Address
# Defaults to onboarding@resend.dev until your custom domain is verified in Resend
RESEND_FROM_EMAIL=Your Name <onboarding@resend.dev>
